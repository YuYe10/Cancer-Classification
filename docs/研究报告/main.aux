\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces 六种融合策略 Accuracy 均值与 95\% 置信区间对比。数据来源为主线实验 repeated stratified CV，5 折乘以 10 重复，共 $n=50$ 测试折。Concat-SVM 取得最高均值90.64\%，Stacking 最低85.56\%。\relax }}{30}{figure.caption.18}\protected@file@percent }
\newlabel{fig:accuracy_ci_mainline}{{12}{30}{六种融合策略 Accuracy 均值与 95\% 置信区间对比。数据来源为主线实验 repeated stratified CV，5 折乘以 10 重复，共 $n=50$ 测试折。Concat-SVM 取得最高均值90.64\%，Stacking 最低85.56\%。\relax }{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 六种方法 fold-level Accuracy 分布箱线图，含抖动散点。数据来源为各实验 JSON 日志中的 50 个测试折 fold-level Accuracy 值。Concat-SVM 与 MOFA 的中位线均高于其他方法，Stacking 分布离散度最大。\relax }}{30}{figure.caption.19}\protected@file@percent }
\newlabel{fig:accuracy_distribution_mainline}{{13}{30}{六种方法 fold-level Accuracy 分布箱线图，含抖动散点。数据来源为各实验 JSON 日志中的 50 个测试折 fold-level Accuracy 值。Concat-SVM 与 MOFA 的中位线均高于其他方法，Stacking 分布离散度最大。\relax }{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Concat 融合特征维度敏感性分析。数据来源为Concat 维度敏感性实验，5 折乘以 3 重复，共 $n=15$ 测试折。维度从 100 增至 500 时 Macro-F1 持续提升，500 维之后趋于饱和，约0.90，dim100 时因信息损失严重出现明显欠拟合。\relax }}{31}{figure.caption.20}\protected@file@percent }
\newlabel{fig:dim_sensitivity}{{14}{31}{Concat 融合特征维度敏感性分析。数据来源为Concat 维度敏感性实验，5 折乘以 3 重复，共 $n=15$ 测试折。维度从 100 增至 500 时 Macro-F1 持续提升，500 维之后趋于饱和，约0.90，dim100 时因信息损失严重出现明显欠拟合。\relax }{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces MOFA 潜在因子数敏感性分析。数据来源为MOFA 因子数敏感性实验，5 折乘以 3 重复，共 $n=15$ 测试折。因子数 15到20 区间性能最优，Macro-F1 约0.896，因子数增至 25 时出现性能下降，Macro-F1 降至 86.80\%，提示过多因子引入噪声或过拟合风险。\relax }}{31}{figure.caption.21}\protected@file@percent }
\newlabel{fig:factors_sensitivity}{{15}{31}{MOFA 潜在因子数敏感性分析。数据来源为MOFA 因子数敏感性实验，5 折乘以 3 重复，共 $n=15$ 测试折。因子数 15到20 区间性能最优，Macro-F1 约0.896，因子数增至 25 时出现性能下降，Macro-F1 降至 86.80\%，提示过多因子引入噪声或过拟合风险。\relax }{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Stacking 变体性能对比热力图。数据来源为Stacking 变体实验，5 折乘以 5 重复，共 $n=25$ 测试折。行为基模型配置，XGB、RF、SVM，列为元模型配置。被设计为SOTA的 XGB+XGB 组合仅获 Macro-F1 等于78.66\%，为全部 Stacking 变体中最低，RF+XGB Hybrid 取得组内最优，Macro-F1 等于85.07\%。\relax }}{32}{figure.caption.22}\protected@file@percent }
\newlabel{fig:stacking_heatmap}{{16}{32}{Stacking 变体性能对比热力图。数据来源为Stacking 变体实验，5 折乘以 5 重复，共 $n=25$ 测试折。行为基模型配置，XGB、RF、SVM，列为元模型配置。被设计为SOTA的 XGB+XGB 组合仅获 Macro-F1 等于78.66\%，为全部 Stacking 变体中最低，RF+XGB Hybrid 取得组内最优，Macro-F1 等于85.07\%。\relax }{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces 消融实验各组件贡献度分析。数据来源为消融实验，5 折乘以 5 重复，共 $n=25$ 测试折。横轴为消融条件，Full、no\_FS、no\_Meth、no\_RNA、balanced，纵轴为 Macro-F1。去除甲基化导致性能下降最大，减8.8\%，去除特征筛选影响最小，减2.7\%，证实了甲基化信息对跨组学互补的不可替代贡献。\relax }}{32}{figure.caption.23}\protected@file@percent }
\newlabel{fig:ablation_comparison}{{17}{32}{消融实验各组件贡献度分析。数据来源为消融实验，5 折乘以 5 重复，共 $n=25$ 测试折。横轴为消融条件，Full、no\_FS、no\_Meth、no\_RNA、balanced，纵轴为 Macro-F1。去除甲基化导致性能下降最大，减8.8\%，去除特征筛选影响最小，减2.7\%，证实了甲基化信息对跨组学互补的不可替代贡献。\relax }{figure.caption.23}{}}
