\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces RNA-only 单模态基线架构。该方法仅使用 RNA-seq 表达数据作为输入，经过预处理后直接输入分类器进行亚型预测。作为单模态基线，其性能为后续融合方法的收益评估提供参照基准。\relax }}{21}{figure.caption.8}\protected@file@percent }
\newlabel{fig:rna-only}{{5}{21}{RNA-only 单模态基线架构。该方法仅使用 RNA-seq 表达数据作为输入，经过预处理后直接输入分类器进行亚型预测。作为单模态基线，其性能为后续融合方法的收益评估提供参照基准。\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Concat 早期融合架构。该方法将 RNA-seq 与甲基化特征在特征空间直接拼接（约4000维），形成联合特征表示后输入分类器。此方法不引入额外参数，是最简单的多模态融合基线。\relax }}{22}{figure.caption.9}\protected@file@percent }
\newlabel{fig:concat}{{6}{22}{Concat 早期融合架构。该方法将 RNA-seq 与甲基化特征在特征空间直接拼接（约4000维），形成联合特征表示后输入分类器。此方法不引入额外参数，是最简单的多模态融合基线。\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces MOFA 潜在因子融合架构。该方法通过多因子分析将高维组学数据压缩为15-20个潜在因子，捕捉跨模态共享信息。潜在因子矩阵随后输入分类器进行预测，实现基于因子分解的中期融合。\relax }}{22}{figure.caption.10}\protected@file@percent }
\newlabel{fig:mofa}{{7}{22}{MOFA 潜在因子融合架构。该方法通过多因子分析将高维组学数据压缩为15-20个潜在因子，捕捉跨模态共享信息。潜在因子矩阵随后输入分类器进行预测，实现基于因子分解的中期融合。\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Stacking 晚期集成架构。该方法首先在两个模态上分别训练基模型，获取 out-of-fold 预测概率作为元特征，再通过元学习器进行最终融合决策，实现决策级的晚期融合。\relax }}{23}{figure.caption.11}\protected@file@percent }
\newlabel{fig:stacking}{{8}{23}{Stacking 晚期集成架构。该方法首先在两个模态上分别训练基模型，获取 out-of-fold 预测概率作为元特征，再通过元学习器进行最终融合决策，实现决策级的晚期融合。\relax }{figure.caption.11}{}}
